# .gitignore for HR Attrition Excel Project
# OS generated files
Thumbs.db
Desktop.ini

# Excel backup and temporary files
~$*.xlsx
*.xlsb~
*.xlsx~
*.xls~
*.xlsm~

# Temporary files
*.tmp
*.log

# Python cache
__pycache__/
*.pyc

# Node modules
node_modules/

# Build artifacts
dist/
build/

# macOS system files
.DS_Store
